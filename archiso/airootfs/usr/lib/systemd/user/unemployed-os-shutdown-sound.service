[Unit]
Description=Play Unemployed OS shutdown/logout chime
# There's no XDG "autostop" counterpart to autostart/ -- a unit's own
# ExecStop is the standard way to hook logout: systemd runs it when this
# unit is torn down, which happens when graphical-session.target stops --
# both on a plain logout AND on system shutdown/reboot (shutdown.target
# pulls down every active session's graphical-session.target as part of
# the ordinary teardown sequence, so this fires for both cases the user
# actually asked for).
#
# After=<audio units> matters here specifically for the shutdown/reboot
# case: systemd stops units in the *reverse* of their After= order, so
# "After=pipewire.service" means we get stopped (and our ExecStop runs)
# BEFORE pipewire stops, not after. Without this, on a fast poweroff
# there's a real race where pipewire could already be torn down by the
# time our ExecStop tries to play through it -- silently no-op.
PartOf=graphical-session.target
After=pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true
ExecStop=/usr/bin/canberra-gtk-play -i desktop-logout -d "unemployed-os-shutdown"

[Install]
WantedBy=graphical-session.target
